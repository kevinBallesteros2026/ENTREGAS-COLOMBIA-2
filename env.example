# Copia este archivo como ".env.local" para desarrollo local,
# y añade estas mismas variables en Vercel (Settings -> Environment Variables) para producción.

# --- WhatsApp de la tienda, donde te llegarán los pedidos ---
# Formato: código de país + número, SIN "+", SIN espacios ni guiones.
# Ejemplo Colombia: 573001112233
NEXT_PUBLIC_WHATSAPP_NUMBER=573001112233

# --- Facebook / Meta Pixel (Meta Events Manager) ---
NEXT_PUBLIC_FB_PIXEL_ID=000000000000000

# --- Moneda para mostrar los precios (código en mayúsculas, ej: COP, MXN, ARS, CLP) ---
NEXT_PUBLIC_CURRENCY=COP
